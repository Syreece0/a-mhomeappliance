# ---- Core ----
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000

# ---- Database (PostgreSQL). Leave empty to fall back to local SQLite for quick dev ----
DATABASE_URL=postgres://am_user:am_pass@localhost:5432/am_store

# ---- Cloudinary (leave empty to store uploads on local disk) ----
CLOUDINARY_URL=

# ---- Paystack: choose test or live; keys are read for the selected mode only ----
PAYSTACK_MODE=test
PAYSTACK_TEST_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_TEST_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=

# ---- Email ----
# Development: console backend prints emails in the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production SMTP example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=A&M Home Appliances <no-reply@example.com>

# ---- Celery / Redis ----
REDIS_URL=redis://localhost:6379/0
# True = run background tasks inline (no worker needed for dev). Set False in production.
CELERY_EAGER=True

# ---- Production security (only applied when DJANGO_DEBUG=False) ----
SECURE_SSL_REDIRECT=True
